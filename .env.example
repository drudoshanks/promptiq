# ---------------------------------------------------------------------------
# PromptIQ environment (copy to .env.local for local development)
# Never commit real secrets. Production secrets belong in a secret manager.
# ---------------------------------------------------------------------------

# Public URL of this deployment (no trailing slash). Used for auth callbacks,
# CSRF origin checks and billing redirects.
APP_URL=http://localhost:3000

# PostgreSQL connection string (local docker-compose default below)
DATABASE_URL=postgresql://promptiq:promptiq@localhost:5432/promptiq

# Auth (Better Auth). Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Optional social providers. Leave blank to show email/password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Transactional email for password recovery. Leave blank in development: reset
# links are printed to the server log instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="PromptIQ <no-reply@example.com>"

# Optimisation provider (A-02: users never supply keys):
#   "open"   open-source model (Llama, Qwen, Gemma, Mistral, gpt-oss ...) through
#            any OpenAI-compatible chat API: Ollama, LM Studio, vLLM, llama.cpp,
#            or a hosted one such as Groq, OpenRouter or Together
#   "openai" official OpenAI API
#   "mock"   built-in rule-based engine (no AI model, no network, free)
OPTIMISER_PROVIDER=mock

# --- Open-source models (OPTIMISER_PROVIDER=open) ---------------------------
# Ollama on this machine (default). Hosted examples:
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Together:   https://api.together.xyz/v1
OPEN_MODEL_BASE_URL=http://localhost:11434/v1
# Leave blank for Ollama / LM Studio; required by hosted services.
OPEN_MODEL_API_KEY=
# Model name exactly as the server knows it (Ollama: `ollama list`).
OPEN_MODEL=qwen2.5:7b
# json_schema (constrained output, best) or json_object for hosts without
# schema support. PromptIQ switches automatically if json_schema is rejected.
OPEN_MODEL_OUTPUT=json_schema
# Local models on a laptop can be slow; allow up to two minutes.
OPEN_MODEL_TIMEOUT_MS=120000
# "rules": if the model server is down or keeps returning unusable output,
# answer with the rule-based engine instead of an error. "none" to disable.
OPEN_MODEL_FALLBACK=rules

# --- OpenAI (OPTIMISER_PROVIDER=openai) -------------------------------------
OPENAI_API_KEY=
# Model ID is server configuration only (FR-022, A-09). Verify availability and
# price in src/lib/config/models.ts before release.
OPTIMISER_MODEL=gpt-5-mini
# Reasoning effort for reasoning-capable models (low keeps latency inside the
# p95 target). Leave empty for models that do not accept the parameter.
OPTIMISER_REASONING_EFFORT=low
# Hard output ceiling per optimisation (tokens); client requests are clamped.
OPTIMISER_MAX_OUTPUT_TOKENS=1500
# Provider timeout in milliseconds
OPTIMISER_TIMEOUT_MS=20000

# Cost control (NFR-012): hard stop when the estimated provider spend for the
# current UTC day exceeds this amount (USD). Set 0 to disable.
GLOBAL_DAILY_SPEND_CAP_USD=25

# Billing (Stripe). Leave blank to run without billing; upgrade buttons are hidden.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

# UPI payments with manual verification (India). Leave UPI_VPA blank to turn
# the feature off. Users pay this UPI ID outside PromptIQ; an administrator
# verifies each payment against the bank statement or UPI merchant app before
# the subscription is activated. No payment gateway is involved.
UPI_VPA=
UPI_PAYEE_NAME=PromptIQ
# Hours a payment request stays open before it expires
UPI_REQUEST_TTL_HOURS=48
# Days to keep payment screenshots after the request is decided
PAYMENT_SCREENSHOT_RETENTION_DAYS=180

# Comma-separated emails that may open /admin and /api/v1/admin/* (FR-020)
ADMIN_EMAILS=

# Log level: debug | info | warn | error
LOG_LEVEL=info
