# ---------------------------------------------------------------------------
# PromptIQ environment (copy to .env.local for local development)
# Never commit real secrets. Production secrets belong in a secret manager.
# ---------------------------------------------------------------------------

# Public URL of this deployment (no trailing slash). Used for auth callbacks,
# CSRF origin checks and billing redirects.
APP_URL=http://localhost:3000

# PostgreSQL connection string (local docker-compose default below)
DATABASE_URL=postgresql://promptiq:promptiq@localhost:5432/promptiq

# Auth (Better Auth). Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Optional social providers. Leave blank to show email/password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Transactional email for password recovery. Leave blank in development: reset
# links are printed to the server log instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="PromptIQ <no-reply@example.com>"

# Optimisation provider: "openai" (official API, server-held key) or "mock"
# (deterministic local rewrite, no network). A-02: users never supply keys.
OPTIMISER_PROVIDER=mock
OPENAI_API_KEY=
# Model ID is server configuration only (FR-022, A-09). Verify availability and
# price in src/lib/config/models.ts before release.
OPTIMISER_MODEL=gpt-5-mini
# Reasoning effort for reasoning-capable models (low keeps latency inside the
# p95 target). Leave empty for models that do not accept the parameter.
OPTIMISER_REASONING_EFFORT=low
# Hard output ceiling per optimisation (tokens); client requests are clamped.
OPTIMISER_MAX_OUTPUT_TOKENS=1500
# Provider timeout in milliseconds
OPTIMISER_TIMEOUT_MS=20000

# Cost control (NFR-012): hard stop when the estimated provider spend for the
# current UTC day exceeds this amount (USD). Set 0 to disable.
GLOBAL_DAILY_SPEND_CAP_USD=25

# Billing (Stripe). Leave blank to run without billing; upgrade buttons are hidden.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

# Comma-separated emails that may open /admin and /api/v1/admin/* (FR-020)
ADMIN_EMAILS=

# Log level: debug | info | warn | error
LOG_LEVEL=info
